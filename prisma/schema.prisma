generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

// Profesional que usa la agenda (médico, psicólogo, kinesiólogo, etc.)
model Professional {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  profession   String
  slug         String   @unique
  createdAt    DateTime @default(now())

  availability Availability[]
  services     Service[]
  patients     Patient[]
  appointments Appointment[]
}

// Bloques de horario de atención por día de la semana (0 = domingo ... 6 = sábado)
model Availability {
  id             String       @id @default(cuid())
  professionalId String
  professional   Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  weekday        Int
  startTime      String // "09:00"
  endTime        String // "13:00"
}

// Tipo de atención con su duración (ej: "Primera consulta" 60 min, "Control" 30 min)
model Service {
  id             String        @id @default(cuid())
  professionalId String
  professional   Professional  @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  name           String
  durationMin    Int
  active         Boolean       @default(true)
  appointments   Appointment[]
}

model Patient {
  id             String       @id @default(cuid())
  professionalId String
  professional   Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  name           String
  email          String
  phone          String
  birthDate      String?
  createdAt      DateTime     @default(now())

  appointments Appointment[]
  followUp     FollowUp?

  @@unique([professionalId, email])
}

// Seguimiento del paciente: se crea automáticamente al registrarse
model FollowUp {
  id        String          @id @default(cuid())
  patientId String          @unique
  patient   Patient         @relation(fields: [patientId], references: [id], onDelete: Cascade)
  status    String          @default("ACTIVO") // ACTIVO | EN_PAUSA | ALTA
  goal      String          @default("")
  createdAt DateTime        @default(now())
  entries   FollowUpEntry[]
}

model FollowUpEntry {
  id         String   @id @default(cuid())
  followUpId String
  followUp   FollowUp @relation(fields: [followUpId], references: [id], onDelete: Cascade)
  kind       String   @default("NOTA") // SISTEMA | NOTA
  text       String
  createdAt  DateTime @default(now())
}

model Appointment {
  id             String       @id @default(cuid())
  professionalId String
  professional   Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  patientId      String
  patient        Patient      @relation(fields: [patientId], references: [id], onDelete: Cascade)
  serviceId      String
  service        Service      @relation(fields: [serviceId], references: [id])
  start          DateTime
  end            DateTime
  status         String       @default("PROGRAMADO") // PROGRAMADO | ATENDIDO | CANCELADO | AUSENTE
  reason         String       @default("")
  createdAt      DateTime     @default(now())

  @@index([professionalId, start])
}

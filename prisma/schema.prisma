generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

// Profesional que usa la agenda (médico, psicólogo, kinesiólogo, etc.)
model Professional {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  profession   String
  slug         String   @unique
  phone        String   @default("")
  license      String   @default("") // matrícula profesional
  address      String   @default("") // lugar de atención (consultorio / dirección)
  bio          String   @default("")
  suspended    Boolean  @default(false) // si un admin la suspende, no puede ingresar ni recibir turnos nuevos
  createdAt    DateTime @default(now())

  photo        ProfessionalPhoto?
  educations   Education[]
  workplaces   Workplace[]
  resets       PasswordReset[]
  availability Availability[]
  services     Service[]
  patients     Patient[]
  appointments Appointment[]
}

// Bloques de horario de atención por día de la semana (0 = domingo ... 6 = sábado)
model Availability {
  id             String       @id @default(cuid())
  professionalId String
  professional   Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  weekday        Int
  startTime      String // "09:00"
  endTime        String // "13:00"
}

// Tipo de atención con su duración (ej: "Primera consulta" 60 min, "Control" 30 min)
model Service {
  id             String        @id @default(cuid())
  professionalId String
  professional   Professional  @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  name           String
  durationMin    Int
  active         Boolean       @default(true)
  appointments   Appointment[]
}

model Patient {
  id             String       @id @default(cuid())
  professionalId String
  professional   Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  name           String // nombre de pila
  lastName       String       @default("")
  email          String
  phone          String
  birthDate      String?
  createdAt      DateTime     @default(now())

  appointments Appointment[]
  followUp     FollowUp?

  @@unique([professionalId, email])
}

// Seguimiento del paciente: se crea automáticamente al registrarse
model FollowUp {
  id        String          @id @default(cuid())
  patientId String          @unique
  patient   Patient         @relation(fields: [patientId], references: [id], onDelete: Cascade)
  status    String          @default("ACTIVO") // ACTIVO | EN_PAUSA | ALTA
  goal      String          @default("")
  createdAt DateTime        @default(now())
  entries   FollowUpEntry[]
}

model FollowUpEntry {
  id         String   @id @default(cuid())
  followUpId String
  followUp   FollowUp @relation(fields: [followUpId], references: [id], onDelete: Cascade)
  kind       String   @default("NOTA") // SISTEMA | NOTA
  text       String
  createdAt  DateTime @default(now())
}

model Appointment {
  id             String       @id @default(cuid())
  professionalId String
  professional   Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  patientId      String
  patient        Patient      @relation(fields: [patientId], references: [id], onDelete: Cascade)
  serviceId      String
  service        Service      @relation(fields: [serviceId], references: [id])
  start          DateTime
  end            DateTime
  status         String       @default("PROGRAMADO") // PROGRAMADO | ATENDIDO | CANCELADO | AUSENTE
  reason         String       @default("")
  createdAt      DateTime     @default(now())

  @@index([professionalId, start])
}

// Token de un solo uso para restablecer la contraseña (se guarda solo el hash)
model PasswordReset {
  id             String       @id @default(cuid())
  professionalId String
  professional   Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  tokenHash      String       @unique
  expiresAt      DateTime
  usedAt         DateTime?
  createdAt      DateTime     @default(now())
}

// Foto de perfil en tabla aparte para no cargar los bytes en cada consulta del profesional
model ProfessionalPhoto {
  professionalId String       @id
  professional   Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  data           Bytes
  contentType    String
  updatedAt      DateTime     @updatedAt
}

// Trayecto académico
model Education {
  id             String       @id @default(cuid())
  professionalId String
  professional   Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  title          String
  institution    String
  startYear      Int?
  endYear        Int? // null = en curso
}

// Lugares de trabajo
model Workplace {
  id             String       @id @default(cuid())
  professionalId String
  professional   Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  name           String
  role           String       @default("")
  address        String       @default("")
  startYear      Int?
  endYear        Int? // null = actualmente
}

// Administrador de la plataforma: controla las cuentas de los profesionales
model Admin {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  createdAt    DateTime @default(now())
}

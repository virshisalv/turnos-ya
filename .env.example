# Neon (https://neon.tech) -> Connection Details.
# DATABASE_URL: conexión "Pooled" (host con -pooler)
DATABASE_URL="postgresql://USUARIO:CLAVE@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require&pgbouncer=true"
# DIRECT_URL: conexión directa (sin -pooler), la usa "npx prisma db push"
DIRECT_URL="postgresql://USUARIO:CLAVE@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require"

# Texto largo y secreto (para firmar las sesiones)
SESSION_SECRET="cambia-esto-por-un-secreto-largo"

# Dirección pública de la app (para los links de recuperar contraseña)
APP_URL="http://localhost:3000"
